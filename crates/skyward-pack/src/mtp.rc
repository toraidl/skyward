# The stock recovery program, which Skyward replaces, is what asks init
# for adb on these phones; the stock rc only does so in the `fs` stage,
# which a recovery never reaches. Ask for it as the recovery boots.
on boot
    setprop sys.usb.config adb

# File transfer: an MTP function beside adb. Skyward serves the function
# itself; once it has written the descriptors it sets sys.usb.ffs.mtp.ready,
# and with adbd ready too, init binds the two together.
on fs && property:sys.usb.configfs=1
    mkdir /config/usb_gadget/g1/functions/ffs.mtp
    mkdir /dev/usb-ffs/mtp 0770 root root
    mount functionfs mtp /dev/usb-ffs/mtp rmode=0770,fmode=0660,uid=0,gid=0

# The stock rules start adbd only for the bare "adb" configuration. A
# recovery offering file transfer asks for "mtp,adb" instead, and its adbd
# is then never started: with no adb function bound, sys.usb.ffs.ready never
# becomes 1, init never writes the controller, and the port stays down
# entirely. Nothing here sets sys.usb.config_disable.
on property:sys.usb.config=mtp,adb
    start adbd

# Naming the MTP function in the first link is left to Skyward, which does
# it once the port has settled on mtp,adb: a rule here fires again on every
# rebind, because taking the port down makes adbd write its function's
# readiness again, and the port is left being rebuilt in a loop. Skyward
# unbinds, renames both links and binds, and reads the first one back.

# The stock rules take the first function off; this takes the second.
on property:sys.usb.config=none && property:sys.usb.configfs=1
    rm /config/usb_gadget/g1/configs/b.1/f2
