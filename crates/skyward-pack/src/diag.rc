
# Keep snapshots without /data or USB. Prefer the OnePlus op2 log filesystem,
# with the stock recovery's mounted persist filesystem as a fallback.
service skyward-diag /system/bin/sh /system/bin/skyward-diag.sh /mnt/vendor/persist/skyward 3
    disabled
    oneshot
    user root
    group root
    seclabel u:r:recovery:s0

on boot
    start skyward-diag
